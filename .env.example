# ==============================================================================
# Voto Claro — Exemplo de Variáveis de Ambiente (NÃO coloque chaves reais aqui)
# ==============================================================================

# --- Servidor Node.js / Fastify ---
# Porta injetada automaticamente pela plataforma de hospedagem (Render, Railway, Cloud Run, Fly.io)
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Chave opcional da Google Fact Check Tools API (exclusiva do servidor — NUNCA use prefixo VITE_)
FACT_CHECK_API_KEY=

# Origens permitidas via CORS apenas se o front-end for hospedado em domínio separado da API
# Exemplo: ALLOWED_ORIGINS=https://voto-claro.netlify.app,https://votoclaro.org
ALLOWED_ORIGINS=

# --- Front-end Vite (usado apenas se o front-end for publicado separadamente da API) ---
# Na hospedagem unificada (recomendada), deixe vazio para usar o mesmo domínio HTTPS (/api/verify)
VITE_API_BASE_URL=
